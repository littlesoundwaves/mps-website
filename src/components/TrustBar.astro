---
import { Image } from 'astro:assets';
import { siteData } from '../data/siteData';
import { aaosLogo } from '../config/images';

interface Props {
  items?: { label: string; value?: string }[];
}

const { items = siteData.trustItems } = Astro.props;
---

<section class="border-y border-border bg-surface" aria-label="Trust signals">
  <div class="mx-auto max-w-site overflow-x-auto px-4 py-5 sm:px-6 sm:py-6">
    <ul class="flex flex-wrap items-center justify-evenly gap-6" role="list">
      <li class="flex shrink-0 items-center justify-center">
        <Image
          src={aaosLogo}
          alt="Member of the Australasian Association of Supervision"
          width={120}
          height={120}
          loading="eager"
          class="h-16 w-auto object-contain sm:h-20"
        />
      </li>
      {items.map(({ label, value }: { label: string; value?: string }) => (
        <li class="flex shrink-0 items-center justify-center gap-2.5 text-center text-sm sm:text-base">
          <span class="font-heading font-semibold text-text">
            {value && <span class="text-primary mr-1">{value}</span>}
            {label}
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>
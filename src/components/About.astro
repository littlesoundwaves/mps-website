---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import CTA from '../components/CTA.astro';
import { Image } from 'astro:assets';
import { brand } from '../config/brand';
import { siteData } from '../data/siteData';
import { storyImage } from '../config/images';

const { about } = siteData;
const tony = about.team[0];
---

<BaseLayout
  title="About Tony Calman — Accredited Pastoral Supervisor"
  description="Meet Tony Calman, an accredited pastoral supervisor supporting Christian ministers, chaplains, and church workers online and in person across Australia."
>
  <Header slot="header" />

  <Banner title="About" />

  <!-- Story -->
  <section class="py-section">
    <div class="mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-14">
      <div class="overflow-hidden rounded-lg shadow-lg">
        <Image
          src={storyImage}
          alt="Tony Calman preaching"
          width={800}
          height={600}
          loading="lazy"
          class="size-full object-cover"
        />
      </div>
      <div class="space-y-5">
        <span class="text-topper font-bold uppercase tracking-widest text-accent">Our Story</span>
        <h2 class="font-heading text-h2 font-bold uppercase text-text">Purpose, vision &amp; values</h2>
        {about.story.map((paragraph) => (
          <p class="text-text-muted leading-relaxed">{paragraph}</p>
        ))}
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="bg-surface py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <span class="text-topper font-bold uppercase tracking-widest text-accent">Your Supervisor</span>
        <h2 class="mt-2 font-heading text-h2 font-bold uppercase text-text">About {tony.name}</h2>
      </div>

      <div class="mx-auto grid max-w-4xl grid-cols-1 gap-10 lg:grid-cols-[280px_1fr] lg:gap-12">
        <div class="mx-auto w-full max-w-xs lg:mx-0">
          <div class="overflow-hidden rounded-lg bg-background shadow-sm">
            <Image
              src={tony.image}
              alt={tony.name}
              width={400}
              height={400}
              loading="lazy"
              class="aspect-square w-full object-cover object-top"
            />
          </div>
          <h3 class="mt-4 font-heading text-lg font-semibold text-text">{tony.name}</h3>
          <p class="text-sm text-text-muted">{tony.role}</p>
        </div>

        <div class="space-y-4">
          {tony.bio.map((paragraph) => (
            <p class="text-text-muted leading-relaxed">{paragraph}</p>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CTA />

  <Footer slot="footer" />
</BaseLayout>

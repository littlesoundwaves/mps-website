---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { aboutImage as localAboutImage } from '../config/images';

const PLACEHOLDER = 'https://images.unsplash.com/photo-1581578731548-c64695cc6952?w=900&q=80';

interface Props {
  topper?: string;
  heading?: string;
  body?: string[];
  benefits?: string[];
  ctaLabel?: string;
  ctaHref?: string;
  imageSrc?: ImageMetadata | string;
  imageAlt?: string;
}

const {
  topper = 'Our Approach',
  heading = 'Integrity of heart and skilful hands',
  body = [
    'Pastoral Supervision is an opportunity for those engaged in Christian ministry to meet with a skilled, independent supervisor to evaluate their practice — through courageous conversations and honest reflection, within a relationship of trust and confidentiality.',
    'Sessions are led by Tony Calman, an ordained Baptist minister with over two decades of local church ministry experience and a Graduate Certificate in Pastoral Supervision from St Marks National Theological Centre.',
  ],
  benefits = [
    'Courageous conversations',
    'Honest reflection',
    'Personal growth',
    'Leadership development',
    'Clear purpose',
  ],
  ctaLabel = 'More About Us',
  ctaHref = '/about',
  imageSrc = localAboutImage ?? PLACEHOLDER,
  imageAlt = 'Tony Calman, Pastoral Supervisor',
} = Astro.props;
---

<section class="py-section">
  <div class="mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-14">

    <!-- Image -->
    <div class="overflow-hidden rounded-lg shadow-lg">
      <Image
        src={imageSrc}
        alt={imageAlt}
        width={700}
        height={800}
        loading="lazy"
        decoding="async"
        class="size-full object-cover object-top"
      />
    </div>

    <!-- Content -->
    <div class="space-y-5">
      <span class="text-topper font-bold uppercase tracking-widest text-accent">{topper}</span>
      <h2 class="font-heading text-h2 font-bold uppercase text-text">{heading}</h2>

      {body.map((paragraph) => (
        <p class="text-text-muted leading-relaxed">{paragraph}</p>
      ))}

      <!-- Values list -->
      <ul class="space-y-3 pt-2" role="list">
        {benefits.map((benefit) => (
          <li class="flex items-start gap-3">
            <span class="mt-0.5 shrink-0 text-accent font-bold" aria-hidden="true">&check;</span>
            <span class="text-text">{benefit}</span>
          </li>
        ))}
      </ul>

      <div class="pt-2">
        <a
          href={ctaHref}
          class="inline-flex min-h-11 items-center gap-2 rounded-md bg-primary px-6 py-3 text-base font-bold text-primary-fg shadow-sm transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          {ctaLabel}
        </a>
      </div>
    </div>
  </div>
</section>
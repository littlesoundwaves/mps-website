---
interface Props {
  topper?: string;
  heading?: string;
}

const {
  topper = 'Reviews',
  heading = 'What Other Ministers and Christian Leaders Say',
} = Astro.props;
---

<section class="bg-surface py-section">
  <div class="mx-auto max-w-site px-4 text-center sm:px-6">
    <span class="text-topper font-bold uppercase tracking-widest text-accent">{topper}</span>
    <h2 class="mt-2 font-heading text-h2 font-bold uppercase text-text">{heading}</h2>

    <div class="mt-8">
      <!-- Elfsight Google Reviews | My Pastoral Supervision -->
      <script src="https://elfsightcdn.com/platform.js" async is:inline></script>
      <div class="elfsight-app-e5fee799-aee9-4701-84a5-9c3d520c6566" data-elfsight-app-lazy></div>
    </div>
  </div>
</section>

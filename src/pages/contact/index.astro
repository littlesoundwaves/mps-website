---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Banner from "../../components/Banner.astro";
import { brand } from "../../config/brand";
import { siteData } from "../../data/siteData";
---

<BaseLayout
  title="Contact"
  description={`Get in touch with ${brand.name}. Book a session or ask a question.`}
>
  <Header slot="header" />

  <Banner title="Contact Us" />

  <section class="py-section">
    <div
      class="mx-auto grid max-w-site grid-cols-1 gap-10 px-4 sm:px-6 lg:grid-cols-5 lg:gap-14"
    >
      <!-- Form -->
      <div class="lg:col-span-3">
        <h2 class="font-heading text-h2 font-bold uppercase text-text">
          Send a message
        </h2>
        <p class="mt-2 mb-8 text-text-muted">
          Fill out the form below and I&rsquo;ll get back to you within one
          business day.
        </p>

        <form
          action="https://api.web3forms.com/submit"
          method="POST"
          class="flex flex-col gap-5"
        >
          <input type="hidden" name="access_key" value="eadb8692-d946-4520-a910-716b27b60fea" />
          <input type="hidden" name="subject" value="New contact form submission from mypastoralsupervision.com.au" />
          <input type="hidden" name="redirect" value="/contact/success" />
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-medium text-text"
              >Name{" "}<span class="text-accent" aria-hidden="true">*</span
              ></span
            >
            <input
              type="text"
              name="name"
              required
              autocomplete="name"
              class="min-h-11 rounded-md border border-border bg-background px-4 py-2.5 text-text transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
            />
          </label>

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-medium text-text"
              >Email{" "}<span class="text-accent" aria-hidden="true">*</span
              ></span
            >
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              class="min-h-11 rounded-md border border-border bg-background px-4 py-2.5 text-text transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
            />
          </label>

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-medium text-text">Phone</span>
            <input
              type="tel"
              name="phone"
              autocomplete="tel"
              inputmode="tel"
              class="min-h-11 rounded-md border border-border bg-background px-4 py-2.5 text-text transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
            />
          </label>

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-medium text-text"
              >Message{" "}<span class="text-accent" aria-hidden="true">*</span
              ></span
            >
            <textarea
              name="message"
              rows="5"
              required
              class="min-h-30 rounded-md border border-border bg-background px-4 py-2.5 text-text transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 resize-y"
            ></textarea>
          </label>

          <button
            type="submit"
            class="mt-2 inline-flex min-h-11 cursor-pointer items-center justify-center self-start rounded-md bg-accent px-8 py-3 text-base font-bold text-accent-fg shadow-sm transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            Send Message
          </button>
        </form>
      </div>

      <!-- Contact info sidebar -->
      <aside class="space-y-8 lg:col-span-2">
        {siteData.phoneFormatted && (
          <div>
            <h3 class="font-heading text-lg font-semibold text-text">Call Us</h3>
            <a
              href={`tel:${siteData.phoneForTel}`}
              class="mt-1 block font-medium text-primary-light transition-colors hover:text-primary"
            >
              {siteData.phoneFormatted}
            </a>
          </div>
        )}

        <div>
          <h3 class="font-heading text-lg font-semibold text-text">Email Us</h3>
          <a
            href={`mailto:${siteData.email}`}
            class="mt-1 block font-medium text-primary-light transition-colors hover:text-primary"
          >
            {siteData.email}
          </a>
        </div>

        <div>
          <h3 class="font-heading text-lg font-semibold text-text">Location</h3>
          <a
            href={siteData.address.mapLink}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-1 block text-text-muted transition-colors hover:text-text"
          >
            {siteData.address.lineOne && (
              <>
                {siteData.address.lineOne}
                <br />
              </>
            )}
            {
              siteData.address.lineTwo && (
                <>
                  {siteData.address.lineTwo}
                  <br />
                </>
              )
            }
            {siteData.address.city}
            {siteData.address.state && `, ${siteData.address.state}`}
            {siteData.address.zip && ` ${siteData.address.zip}`}
          </a>
        </div>

        <div>
          <h3 class="font-heading text-lg font-semibold text-text">Hours</h3>
          <div class="mt-1 space-y-1 text-text-muted">
            {
              siteData.hours.map(({ days, time }) => (
                <p>
                  {days}: {time}
                </p>
              ))
            }
            {
              siteData.emergencyService && (
                <p class="mt-2 font-medium text-accent">
                  {siteData.emergencyService}
                </p>
              )
            }
          </div>
        </div>
      </aside>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>